@model Contact_Management_Web_Application.Models.ContactInfo

<div class="container mt-4">
    <h2 class="text-center mb-4">Add New Contact</h2>

    <div class="card shadow p-4">
        <form method="post">

            <div class="mb-3">
                <label class="form-label">Contact ID</label>
                <input asp-for="ContactId" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">First Name</label>
                <input asp-for="FirstName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input asp-for="LastName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Company</label>
                <input asp-for="CompanyName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="EmailId" type="email" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Mobile</label>
                <input asp-for="MobileNo" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Designation</label>
                <input asp-for="Designation" class="form-control" />
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-success">Save Contact</button>
                <a asp-action="ShowContacts" class="btn btn-secondary">Cancel</a>
            </div>

        </form>
    </div>
</div>