@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-5">
    <div class="card shadow p-4">

        <h2 class="text-center mb-4">Submitted Details</h2>

        <table class="table table-bordered table-striped">
            <tr>
                <th>Name</th>
                <td>@TempData.Peek("Name")</td>
            </tr>
            <tr>
                <th>Age</th>
                <td>@TempData.Peek("Age")</td>
            </tr>
            <tr>
                <th>Course</th>
                <td>@TempData.Peek("Course")</td>
            </tr>
        </table>

        <div class="text-center">
            <a href="/student/register" class="btn btn-success mt-3">Add Another Student</a>
        </div>

    </div>
</div>